// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  peserta_magang
  admin
  sub_koordinator_bidang
}

enum StatusPeserta {
  PENDING
  APPROVED
  REJECTED
}

enum StatusAjuan {
  PENDING
  APPROVED
  REJECTED
}

enum StatusLaporan {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pesertaMagang        PesertaMagang?
  admin                Admin?
  subKoordinatorBidang SubKoordinatorBidang?
  kritikSaran          KritikSaran[]
  ulasanMagang         UlasanMagang[]
  notifikasi           Notifikasi[]
}

model PesertaMagang {
  id          String        @id @default(uuid())
  namaLengkap String        @map("nama_lengkap")
  tglLahir    DateTime      @map("tgl_lahir") @db.Date
  noTelepon   String        @map("no_telepon")
  nik         String
  nimNis      String?       @map("nim_nis")
  instansi    String?
  jurusan     String?
  alamat      String
  instagram   String
  pasFoto     String        @map("pas_foto")
  status      StatusPeserta @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userId   String        @unique @map("user_id")
  bidangId String?       @map("bidang_id")
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bidang   KuotaBidang?  @relation(fields: [bidangId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  ajuan    AjuanMagang[]
}

model AjuanMagang {
  id                String      @id @default(uuid())
  kategoriMagang    String      @map("kategori_magang")
  statusPendidikan  String      @map("status_pendidikan")
  jenjangPendidikan String      @map("jenjang_pendidikan")
  instansi          String?
  jurusan           String?
  tglMulai          DateTime    @map("tgl_mulai") @db.Date
  tglSelesai        DateTime    @map("tgl_selesai") @db.Date
  temaMagang        String      @map("tema_magang")
  statusUsulan      StatusAjuan @default(PENDING) @map("status_usulan")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  pesertaId String        @map("peserta_id")
  bidangId  String        @map("bidang_id")
  peserta   PesertaMagang @relation(fields: [pesertaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bidang    KuotaBidang   @relation(fields: [bidangId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  suratPenerimaan SuratPenerimaan?
  logbook         Logbook[]
  laporan         LaporanHasilMagang?
  sertifikat      Sertifikat?
  berkas          BerkasMagang?
}

model SuratPenerimaan {
  id        String   @id @default(uuid())
  noSurat   String   @map("no_surat")
  fileUrl   String   @map("file_url")
  fileId    String   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  ajuanId String      @unique @map("ajuan_id")
  ajuan   AjuanMagang @relation(fields: [ajuanId], references: [id], onDelete: Cascade)
}

model KuotaBidang {
  id        String   @id @default(uuid())
  nama      String
  kuota     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ajuan          AjuanMagang[]
  subkoordinator SubKoordinatorBidang[]
  PesertaMagang  PesertaMagang[]
  Admin          Admin[]
}

model Admin {
  id        String       @id @default(uuid())
  nama      String       @default("Administrator")
  userId    String       @unique @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bidangId  String?      @map("bidang_id")
  bidang    KuotaBidang? @relation(fields: [bidangId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
}

model SubKoordinatorBidang {
  id       String @id @default(uuid())
  nama     String
  userId   String @unique @map("user_id")
  bidangId String @map("bidang_id")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bidang    KuotaBidang @relation(fields: [bidangId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
}

model Logbook {
  id          String   @id @default(uuid())
  tanggal     DateTime @db.Date
  deskripsi   String   @default("") @db.Text
  logbookFile String?  @map("logbook_file")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ajuanId String      @map("ajuan_id")
  ajuan   AjuanMagang @relation(fields: [ajuanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([ajuanId, tanggal])
}

model KritikSaran {
  id        String   @id @default(uuid())
  nama      String
  email     String
  pesan     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model UlasanMagang {
  id        String   @id @default(uuid())
  ulasan    String
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model LaporanHasilMagang {
  id          String        @id @default(uuid())
  fileLaporan String        @map("file_laporan")
  status      StatusLaporan @default(PENDING)
  catatan     String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  ajuanId String      @unique @map("ajuan_id")
  ajuan   AjuanMagang @relation(fields: [ajuanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Sertifikat {
  id           String   @id @default(uuid())
  noSertifikat String   @map("no_sertifikat")
  nilai        Int
  fileUrl      String   @map("file_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ajuanId String      @unique @map("ajuan_id")
  ajuan   AjuanMagang @relation(fields: [ajuanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model BerkasMagang {
  id                    String   @id @default(uuid())
  suratPengantar        String   @map("surat_pengantar")
  proposalMagang        String   @map("proposal_magang")
  cv                    String
  ktp                   String
  suratBakesbangpolSda  String   @map("surat_bakesbangpol_sda")
  suratBakesbangpolProv String?  @map("surat_bakesbangpol_prov")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  ajuanId String      @unique @map("ajuan_id")
  ajuan   AjuanMagang @relation(fields: [ajuanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Notifikasi {
  id        String   @id @default(uuid())
  tipe      String
  judul     String
  pesan     String
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model StatistikPengunjung {
  tahun Int @id
  count Int @default(0)
}
