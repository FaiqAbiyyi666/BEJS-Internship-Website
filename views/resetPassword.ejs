<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password - Sistem Magang</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet"/>
  <style>
    * {
      font-family: 'Poppins', sans-serif;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #f5f5f5;
      padding: 40px;
    }

    .container {
      max-width: 400px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
      color: #002942;
    }

    h2 {
      text-align: center;
      color: #006DA6;
      margin-bottom: 25px;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    input[type="password"] {
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
    }

    .btn-submit {
      background-color: #006DA6;
      color: #ffffff;
      border: none;
      padding: 12px;
      font-size: 14px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
    }

    .btn-submit:hover {
      background-color: #005481;
    }

    .error-message {
      color: #DD0000;
      font-size: 13px;
      display: none;
    }

    .success-message {
      color: #006DA6;
      font-size: 13px;
      display: none;
      text-align: center;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Atur Ulang Password</h2>
    <form id="resetPasswordForm" method="POST" action="/api/auth/reset-password">
      <input type="hidden" name="token" value="<%= token %>" />

      <input
        type="password"
        name="password"
        id="password"
        placeholder="Password Baru"
        required
      />
      <input
        type="password"
        name="confirmPassword"
        id="confirmPassword"
        placeholder="Konfirmasi Password"
        required
      />

      <p class="error-message" id="errorMessage">Konfirmasi password tidak sesuai</p>
      <button type="submit" class="btn-submit">Update Password</button>
    </form>
    <p class="success-message" id="successMessage">Password berhasil diperbarui!</p>
  </div>

  <script>
    const form = document.getElementById('resetPasswordForm');
    const errorMessage = document.getElementById('errorMessage');

    form.addEventListener('submit', function (e) {
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (password !== confirmPassword) {
        e.preventDefault();
        errorMessage.style.display = 'block';
      } else {
        errorMessage.style.display = 'none';
      }
    });
  </script>
</body>
</html>
